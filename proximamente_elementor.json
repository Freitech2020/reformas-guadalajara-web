                "elType": "widget",
                "isInner": false,
                "widgetType": "html",
                "settings": {
                  "html": "<div class=\"florin-svg-wrapper\" style=\"width:100%; max-width:480px; margin:0 auto; box-sizing:border-box;\">\n  <div style=\"border-radius:20px; overflow:hidden; box-shadow:0 20px 40px rgba(0,0,0,0.22); border:1px solid rgba(15,23,42,0.12); background:#0F172A; aspect-ratio:16/9; width:100%;\">\n    <svg viewBox=\"0 0 480 270\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%; height:100%; display:block;\">\n      <defs>\n        <clipPath id=\"split-clip\">\n          <rect x=\"0\" y=\"0\" width=\"240\" height=\"270\">\n            <animate attributeName=\"width\" values=\"45;435;45\" dur=\"5.5s\" keyTimes=\"0;0.5;1\" calcMode=\"spline\" keySplines=\"0.45 0 0.25 1; 0.45 0 0.25 1\" repeatCount=\"indefinite\" />\n          </rect>\n        </clipPath>\n        <filter id=\"svg-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n          <feGaussianBlur stdDeviation=\"3\" result=\"blur\" />\n          <feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\" />\n        </filter>\n      </defs>\n\n      <!-- CAPA ANTES (Foto Real Estado Previo) -->\n      <g id=\"layer-before\">\n        <image href=\"https://reformasmadrid.seolifeteam.com/wp-content/uploads/2026/10/reforma-antes.webp\" x=\"0\" y=\"0\" width=\"480\" height=\"270\" preserveAspectRatio=\"xMidYMid slice\" />\n        <!-- Badge ANTES fijo a la derecha -->\n        <rect x=\"366\" y=\"14\" width=\"100\" height=\"26\" rx=\"13\" fill=\"rgba(15,23,42,0.85)\" stroke=\"#64748B\" stroke-width=\"1\" />\n        <text x=\"416\" y=\"31\" fill=\"#F8FAFC\" font-size=\"11\" font-weight=\"bold\" font-family=\"sans-serif\" text-anchor=\"middle\">🏷️ ANTES</text>\n      </g>\n\n      <!-- CAPA DESPUÉS (Foto Real Reforma Acabada) -->\n      <g id=\"layer-after\" clip-path=\"url(#split-clip)\">\n        <image href=\"https://reformasmadrid.seolifeteam.com/wp-content/uploads/2026/10/reforma-despues.webp\" x=\"0\" y=\"0\" width=\"480\" height=\"270\" preserveAspectRatio=\"xMidYMid slice\" />\n        <!-- Badge DESPUÉS integrado en la capa revelada -->\n        <rect x=\"14\" y=\"14\" width=\"112\" height=\"26\" rx=\"13\" fill=\"rgba(15,23,42,0.85)\" stroke=\"#10B981\" stroke-width=\"1.5\" />\n        <text x=\"70\" y=\"31\" fill=\"#34D399\" font-size=\"11\" font-weight=\"bold\" font-family=\"sans-serif\" text-anchor=\"middle\">✨ DESPUÉS</text>\n      </g>\n\n      <!-- DIVISOR DINÁMICO CON MICROINTERACCIÓN -->\n      <g id=\"slider-handle\">\n        <animateTransform attributeName=\"transform\" type=\"translate\" values=\"45 0; 435 0; 45 0\" dur=\"5.5s\" keyTimes=\"0;0.5;1\" calcMode=\"spline\" keySplines=\"0.45 0 0.25 1; 0.45 0 0.25 1\" repeatCount=\"indefinite\" />\n        <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"270\" stroke=\"#FFFFFF\" stroke-width=\"3\" filter=\"url(#svg-glow)\" />\n        <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"270\" stroke=\"#2563EB\" stroke-width=\"1.5\" />\n        \n        <circle cx=\"0\" cy=\"135\" r=\"18\" fill=\"#0F172A\" stroke=\"#FFFFFF\" stroke-width=\"2.5\" filter=\"url(#svg-glow)\" />\n        <circle cx=\"0\" cy=\"135\" r=\"14\" fill=\"#2563EB\" />\n        <path d=\"M -7 135 L -3 131 L -3 139 Z M 7 135 L 3 131 L 3 139 Z\" fill=\"#FFFFFF\" />\n      </g>\n    </svg>\n  </div>\n  <div style=\"text-align:center; color:#64748B; font-size:12.5px; font-weight:600; margin-top:10px;\">\n    ✨ Desliza automáticamente · Transformación de espacios en Guadalajara y Madrid\n  </div>\n</div>"
