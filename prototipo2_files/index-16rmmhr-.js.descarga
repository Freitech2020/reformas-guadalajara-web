"Clear draft",current:"Current direct execution grant",grantOption:"This role has a grant option. This permission remains read-only.",invalid:"Select a role and action to preview.",result:"Server preview",before:"Before",after:"After",noChanges:"The server found no changes to direct grants.",gate:"Server apply eligibility",ready:"The server preview allows applying; current project eligibility and explicit confirmation are still required.",blocked:"Blocked by server checks",unknownWarning:"Additional warning; review is required.",unknownReason:"An additional server check blocks applying.",external:"External business dependencies have not been verified.",functionWarning:"The function body and execution mode have not been verified.",ownerWarning:"Ownership or superuser privileges can still allow access.",ownerRequired:"Only the project owner can apply changes.",compatibility:"Compatibility checks are incomplete.",writeKind:"Writes for this object type are not enabled.",sharedBinding:"The database binding is shared.",previewUnavailable:"Preview is not available for this project."},C_e={title:"Confirm permission change",notice:"Review the differences and warnings before applying.",accept:"I have reviewed the differences and warnings and confirm this change to direct grants on the selected object.",apply:"Confirm and apply",result:"Operation result",operationId:"Operation ID",submitting:"Submitting once. Do not resubmit.",running:"Still running. Query this operation for its result.",unknown:"Result unknown. Only query the original operation; do not resubmit.",not_committed:"Confirmed not committed. Read the latest permissions and preview again.",committed_matched:"Committed; current permissions match. This does not confirm business behavior.",committed_unavailable:"Committed; current verification is unavailable. Do not resubmit.",committed_drifted:"Committed previously; current permissions have changed.",query:"Query original operation",querying:"Querying result…",refresh:"Read latest permissions",recovery:"The operation ID is saved for this browser session. Reopening this object queries the original operation.",queryFailed:"Result query failed or returned an unexpected response. This does not prove that the operation was not committed.",uncertain:"The submission response is uncertain. Querying the original operation.",storageFailed:"Recovery information could not be saved or read. Submission is blocked; check browser session storage.",draftNotice:"Draft changes do not take effect until you explicitly confirm. Leaving discards the draft; submitted operations can be queried again.",workspaceNotice:"Browsing and previews do not write permissions. Applying requires explicit confirmation."},I_e={title:"Table permission draft",notice:"Direct table grants do not guarantee data access. Schema permissions and row policies still apply. Other roles, column grants and row policies are not changed.",privileges:"Select table privileges",grant:"Grant selected privileges",revoke:"Revoke selected direct grants",current:"Current direct grant",readonly:"Read-only grant option",SELECT:"Read rows",INSERT:"Insert rows",UPDATE:"Update rows",DELETE:"Delete rows"},E_e={title:"Column permission draft",notice:"Only direct grants for this column are changed. Table grants, role inheritance, schema permissions and row policies can still allow or restrict access.",scope:"Permission scope",tableScope:"Table grants",columnScope:"Column grants",select:"Select a column",privileges:"Select column privileges",current:"Current direct column grant",empty:"This table has no manageable columns.",tableWarning:"A grant to this role or PUBLIC at table level can override column restrictions. Revoking a column grant does not revoke the table grant."},T_e={title:"Sequence permission draft",notice:"Only direct sequence grants change. Browsing and preview do not advance or reset the sequence. Privileges overlap; inheritance, PUBLIC and ownership can still allow access.",privileges:"Select sequence privileges",current:"Current direct sequence grant",USAGE:"Use nextval and currval",SELECT:"Read the sequence and use currval",UPDATE:"Use nextval and setval (reset the value)"},P_e={title:"Schema permission draft",notice:"USAGE allows looking up objects in this schema; it does not grant table, sequence or function privileges. Revoking a direct grant does not guarantee that access stops: inheritance, PUBLIC, ownership and existing session lookups may still allow access. CREATE and object grants are unchanged.",privileges:"Select schema privilege",current:"Current direct schema grant",USAGE:"Look up objects in the schema"},k_e={title:"New object defaults draft",notice:"Only future objects created by the selected creator are affected; existing objects and other creators are unchanged. Defaults use the role actually creating an object, not inherited memberships. Schema defaults add to database defaults; revoking a schema grant cannot remove a database grant.",creator:"Creator role",privileges:"Select default privileges",current:"Current direct default grant",EXECUTE:"Execute new functions",globalWarning:"A database default grant cannot be removed by revoking a schema default.",functionWarning:"Function defaults also include procedures and aggregates.",tableWarning:"Table defaults also include views and foreign tables.",loading:"Reading the default permission baseline…"},A_e={title:"Row policy draft",notice:"Only the selected policy changes. Table grants, other policies and RLS enable/force settings stay unchanged. Policy changes alone do not guarantee data access.",choose:"Choose",create:"Create policy",replace:"Modify policy",drop:"Delete policy",readonly:"Complex or externally modified policies remain read-only.",name:"Policy name",command:"Command",mode:"Policy mode",using:"Visible rows (USING)",check:"Written rows (WITH CHECK)",combine:"Combine rules",single:"Single rule",all:"All rules must match",any:"Any rule may match",rule:"Rule type",owner: