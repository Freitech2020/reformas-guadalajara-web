ixDisplay:'Fix "{item}" on {domain}',empty:{title:"No growth plan for this site yet",body:"The agent will research the site, confirm with you what the business is and where it serves customers, then lay out the plan and start working through it.",cta:"Start growth plan"},planStatus:{onboarding:"Draft",active:"Active",paused:"Paused"},status:{todo:"To do",done:"Done",needs_you:"Needs you",skipped:"Skipped"},actions:{done:"Mark done",skipped:"Skip",todo:"Reopen",fix:"Fix it",openKeywords:"Open Keywords"},kind:{auto:"Agent handles this",user:"Only you can do this",platform:"Platform-side"},indicators:{tracked:"Keywords tracked",top10:"In top 10",top20:"In top 20",aiMentions:"AI mentions"},tile:{noPlan:"No growth plan yet",needsYou:"{n} need you"},stages:{s0:{name:"Foundations",blurb:"Domain, indexing basics and Search Console — nothing else works without these."},s1:{name:"Keywords",blurb:"Decide which searches to win: core and long-tail keywords, each mapped to one page."},s2:{name:"On-site",blurb:"Align existing pages to their keywords, split services into pages, add structured data and FAQs."},s3:{name:"Content",blurb:"A new page and a blog post every week, each built for a keyword cluster from the plan."},s4:{name:"Off-site",blurb:"Business Profile, directories, reviews and links — the signals Google and AI engines check outside the site."},s5:{name:"Iterate",blurb:"Weekly data review: push pages ranking 5–15 into the top 5, fix low click-through titles, track AI visibility."}},items:{stage0_custom_domain:"Custom domain with HTTPS",stage0_meta_unique:"Unique title, description and H1 on every page",stage0_sitemap_robots:"sitemap.xml and robots.txt in place",stage0_canonical:"Canonical URLs set",stage0_gsc_connected:"Google Search Console connected",stage0_sitemap_submitted:"Sitemap submitted to Search Console",stage0_ai_crawlable:"AI crawlers receive full HTML",stage1_seeds_confirmed:"Seed keywords confirmed",stage1_keyword_plan:"Keyword plan approved",stage1_compe