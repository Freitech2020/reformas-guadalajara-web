haven't invited any friends yet",empty2:"share your link now to start earning!"},Oie={subscribed:"Subscribed",awaitingPayment:"Awaiting payment",refunded:"Refunded",subCancelled:"Sub Cancelled"},Nie={creditsAddedBefore:"+",creditsAddedAfter:"credits",rewardLocked:"Reward locked",creditsRevoked:"Credits Revoked",creditsExpired:"Credits have expired"},Mie="View Terms and Conditions",Fie={title:"Invite friends",subtitle:"{highlight}",highlight:"Get more rewards",reward:"Earn {previous} {current} credits",unlimited:"Unlimited invites"},jie={$comment:Aie,tabs:Rie,campaign:Die,stats:xie,inviteList:Lie,status:Oie,info:Nie,viewTerms:Mie,banner:Fie},Bie="All keys in this file are prefixed with: activity.share",Uie={campaign:"Campaign",submitLink:"Submit Link"},$ie={terminated:"The campaign has been terminated.",sharingGuidelines:"Sharing Guidelines",pageTitle:"Share & Earn",shareSectionTitle:"Choose a platform to share",shareOnTwitter:"Share on X(Twitter)",shareOnFacebook:"Share on Facebook",shareOnInstagram:"Share on Instagram",shareOnLinkedIn:"Share on LinkedIn",shareOnReddit:"Share on Reddit"},Vie={rule1:'Mention <span style="font-weight: 600;font-size: 14px;">ReaddyAI</span> and share how Readdy worked for you!',rule2:"Add your project link",rule3:"Add a screenshot or video of your project (optional)",rule4:"For X, Facebook, Instagram, and LinkedIn, follow Readdy's official account and capture a follow screenshot. Reddit doesn't require this.",rule5:"Submit your post link to get rewarded",rule6:"48-hour minimum posting period required"},Gie={projectLink:"Project link",projectSelectPlaceholder:"Select a project",projectLinkPlaceholder:"Paste your project link",noProjectsHint:"No projects yet. Generate one first to get a project link.",projectLinkRequired:"Project link is required",generateVersionHint:"This project has no generated version yet. Generate one to get a project link.",copy:"Post copy",redditTitle:"Post title",redditBody:"Post body",redditDisclaimer:"Templates are for reference only. Replace anything in [brackets] before posting.",randomize:"Random",continueToTwitter:"Continue to X",continueToFacebook:"Copy caption & open Facebook",continueToInstagram:"Copy caption & open Instagram",continueToLinkedIn:"Continue to LinkedIn",continueToReddit:"Continue to Reddit",facebookCopyReady:"Post copy copied. Paste it into Facebook if needed.",instagramCopyReady:"Caption copied. Paste it into Instagram.",linkedinCopyReady:"Post copy copied. Paste it into LinkedIn.",redditCopyReady:"Post copy copied. Paste it into Reddit."},Hie={label:"Submit your link",followScreenshotLabel:"Upload a screenshot proving you follow Readdy",proofTitleBefore:"Submit your link and a screenshot proving you ",proofTitleHighlight:"follow Readdy",proofTitleAfter:"",followScreenshotPlatformPlaceholder:"Select a platform",button:"Submit",placeholderDefault:"Paste and submit your post link",placeholderRewardLimit:"Reward limit reached",placeholderSubmissionLimit:"Submission Limit Reached",terminatedTip:"The campaign has been terminated"},Wie={title:"Submit list",expand:"Expand",collapse:"Collapse",platformTwitter:"Twitter/X",platformFacebook:"Facebook",platformInstagram:"Instagram",platformLinkedIn:"LinkedIn",platformReddit:"Reddit"},Qie={pending:"Pending",underReview:"Under Review",approved:"Approved"},qie={awaitingSubmission:"Pending Submission",pleaseWait:"Please wait for review",creditsAdded:"Credits awarded"},zie={alreadySubmitted:"You have already submitted a link from this platform",linkExists:"Each link can only be submitted once",invalidUrl:"Please provide the link from the respective platform",followScreenshotRequired:"Please upload the follow screenshot for {platform}"},Kie={title:"Submission Rules",rule1:"150 credits awarded instantly upon approval of each social media share link",rule2:"For X, Facebook, Instagram, and LinkedIn, follow Readdy's official account and provide a follow screenshot. Reddit is exempt.",rule3:"Only one reward per social platform. Do not resubmit the same platform",rule4:"Please allow up to 2 minutes for link verification"},Yie=JSON.parse(`{"x":{"template1":"I'm way too excited about this, I built {projectname} in one day with {raaddyaccount} and it actually looks legit\\n\\n{projectsharelink}\\n\\nIf you want to try it too, here's my link: {referrallink}","template2":"everyone keeps asking how I made {projectname} so here:\\n\\n{raaddyaccount}. that's it. no code, no figma, just told it what I wanted\\n{projectsharelink}\\n\\nsign up through me if you want {referrallink}","template3":"ok {projectname} is live\\n\\nmade the whole thing with {raaddyaccount} in one sitting lol\\n\\n{projectsharelink}\\n\\nif you wanna try it yourself -> {referrallink}","template4":"I usually don't post early versions, but {projectname} felt worth sharing.\\nBuilt it with {raaddyaccount} and got it live here: {projectsharelink}\\nIf you want to try Readdy too, my invite gives extra credits: {referrallink}","template5":"Tiny win for me today: {projectname} is finally out of my notes and on the internet.\\nHere's the link: {projectsharelink}\\nBuilt with {raaddyaccount}, and if you want to try it, here's my invite: {referrallink}","template6":"Sent {projectname} to a few friends and figured I should post it here too.\\nMade it with {raaddyaccount}: {projectsharelink}\\nIf you want to build your own, my invite link should get you extra credits: {referrallink}","template7":"This started as a \\"let me just test something\\" idea and somehow became {projectname}.\\n{raaddyaccount} helped me get it live: {projectsharelink}\\nIf you want to try it too, here's my invite: {referrallink}","template8":"Not polished, not final, still posting it anyway: {projectname}.\\nBuilt it with {raaddyaccount}, and it's live here: {projectsharelink}\\nIf you want to try Readdy with bonus credits: {referrallink}","template9":"I don't write code. never have. but I just shipped a whole website by myself!\\n{projectsharelink}\\n\\n{raaddyaccount} let me do this with zero technical knowledge and I'm still processing that. try it {referrallink}","template10":"yo if you've been wanting to make a website but keep putting it off - just use {raaddyaccount}\\n\\nI made {projectname} in like a day and it actually looks good? {projectsharelink}\\n\\n{referrallink}"},"facebook":{"template1":"ok so I actually made a website?? {project_name} is live and I'm weirdly proud of it.\\n\\nUsed {brand_mention} to build it. No code, no hiring a developer, just described what I wanted and it came out like this:\\n{project_link}\\n\\nIf you want to try {brand_mention} too, here's my link to get started free: {invite_link}","template2":"I've been wanting to make this for a while and finally just did it this weekend.\\n\\n{project_name} is live: {project_link}\\n\\nUsed {brand_mention} to put it together. Took me like [time] from start to finish. If anyone needs a website and doesn't want to deal with code, honestly just try it.\\n\\nMy invite if you want to try free: {invite_link}","template3":"Finally made {project_name} and it's actually real now lol\\n\\nI used {brand_mention} to build it and the whole thing was way easier than I expected. No code, no expensive designers, just told it what I wanted.\\n\\nCheck it out: {project_link}\\n\\nIf you want to try {brand_mention}, my link gives you free access to start: {invite_link}","template4":"Not a developer. Never have been. But I just made a whole website by myself and it doesn't look terrible???\\n\\n{project_name}: {project_link}\\nUsed {brand_mention}. If I can do this, literally anyone can.\\nHere's my invite if you wanna try for free: {invite_link}","template5":"{project_name} is done!! I actually shipped something for once\\n\\nMade it with {brand_mention}. Went from \\"I should really make this\\" to \\"it's live on the internet\\" way faster than I thought possible.\\n\\nHere it is: {project_link}\\n\\nMy {brand_mention} link if anyone wants to try it free: {invite_link}","template6":"Kinda can't believe how fast this came together.\\nMade {project_name} with {brand_mention}. No code. Just described what I wanted and tweaked it until it looked right.\\n\\n{project_link}\\n\\nIf you've been putting off making a website, just try it.\\nHere's my invite to start free: {invite_link}","template7":"So I used {brand_mention} to make {project_name} and I need to tell someone about it because I'm way too excited for a normal person.\\n\\nIt just works?? I described what I wanted and it made it?? And it looks good??\\n\\nHere: {project_link}\\n\\nIf you want to try it, my invite gets you in free: {invite_link}","template8":"New project is up. {project_name}. Made it with {brand_mention}.\\n\\nI've tried other website builders before and always hated the result. This one actually came out the way I pictured it.\\n\\n{project_link}\\n\\nInvite link if anyone wants to try {brand_mention} free: {invite_link}","template9":"friends. I made a website. by myself. with no code. and it looks GOOD.\\n{project_name}: {project_link}\\n\\nUsed {brand_mention} to build it. If you've been sitting on an idea and keep thinking \\"I'll make it eventually,\\" just go try it.\\nMy invite for free access: {invite_link}","template10":"{project_name} is live and I need honest opinions. Be nice but be real.\\n\\n{project_link}\\n\\nMade it with {brand_mention}. Way smoother than my last attempt at making a website (we don't talk about that one).\\n\\nIf you want to try {brand_mention} too, here's my link to start free: {invite_link}"},"instagram":{"template1":"just made {projectname} and I'm obsessed with how it turned out🥹\\n\\nbuilt the whole thing with {raaddyaccount} in one sitting. no code, no templates, just described what I wanted.\\n\\n{projectsharelink}\\n\\nwant to try Readdy? here's my invite to start free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#AIWebsite #NoCode #BuildInPublic #SideProject #WebDesign","template2":"from idea to live website in one afternoon??\\n\\n{projectname} is real and it's live. used {raaddyaccount} and honestly can't believe how fast that was.\\n\\n{projectsharelink}\\n\\nmy invite if you wanna try it free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#NoCodeBuilder #WebDesign #CreatorTools #SideProject","template3":"I don't code. never learned. still made this whole website by myself🫠\\n\\n{raaddyaccount} made it stupid easy. just told it what I wanted and here we are.\\n\\n{projectsharelink}\\n\\ninvite to try it free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#NoCode #AITools #WebsiteBuilder #JustShipped","template4":"new project just dropped✨\\n{projectname}\\n\\nmade it with {raaddyaccount} in like a day. still kinda shocked it looks this good for zero effort on the design side.\\n\\n{projectsharelink}\\n\\nwant to try Readdy? here's my invite to start free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#AIWebsite #NoCode #BuildInPublic #SideProject #WebDesign","template5":"that \\"I actually finished something\\" feeling😎\\n{projectname} is live. built with {raaddyaccount}.\\n\\nnot perfect but it's out there and I'm proud of it.\\n\\n{projectsharelink}\\nmy invite to try Readdy free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#ShipIt #NoCode #SideProject #WebDesign","template6":"POV: you had an idea at breakfast and it's a real website by dinner\\n\\n{raaddyaccount} is wild for this. {projectname} is live👀\\n\\n{projectsharelink}\\n\\ntry it free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#AIBuilder #NoCode #BuildInPublic #WebDesign","template7":"rebuilt my site with {raaddyaccount} and it actually looks like a real website now lol\\n\\nthe old one was giving 2019 free template energy. this one I'm actually proud to share.\\n\\n{projectsharelink}\\n\\nmy invite if you want to try free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#WebRedesign #NoCode #AITools #GlowUp","template8":"everyone keeps asking how I made {projectname} so here:\\n\\n{raaddyaccount}. that's literally it.\\n\\nno figma. no code. just vibes and describing what I wanted.\\n\\n{projectsharelink}\\n\\ninvite to try it free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#AIWebsite #NoCode #CreatorTools #BuildInPublic","template9":"made something cool this weekend🛠\\n{projectname}\\nused {raaddyaccount} to build it. the whole process took me [time] and I didn't have to Google a single thing.\\n\\n{projectsharelink}\\n\\nmy invite to start free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#WeekendProject #NoCode #AITools #SideProject #WebDesign","template10":"when the side project actually gets finished for once🙏\\n\\n{projectname} is live. made it with {raaddyaccount}. no code, no drama.\\n\\n{projectsharelink}\\ntry it free: {referrallink}\\n\\n{'@'}readdy.ai.official\\n#SideProject #ShipIt #NoCode #AIWebsite #BuildInPublic"},"linkedin":{"template1":"I finally stopped sitting on this idea and turned it into something real.\\n\\n{projectname} was one of those ideas that kept getting pushed back because making it presentable always seemed like a bigger task than expected.\\n\\nThis week I used Readdy to build a first version and get it into a state I could actually share. What stood out was how quickly I moved from \\"this might be worth exploring\\" to \\"here is a real project people can open.\\"\\n\\nThat shift matters. Once something becomes visible, the conversation gets better.\\n\\nTake a look: {projectsharelink}\\nIf you want to try Readdy for free, here's my invite: {referrallink}\\n\\n#ProductBuilding #StartupBuilding #AIProducts","template2":"One of the hardest parts of building is getting past the blank page.\\n\\nThis week I used Readdy to put together {projectname} and get it into a presentable state much faster than my usual workflow. Instead of spending most of my time on structure and setup, I could focus on the concept itself.\\n\\nWhat I needed was not a perfect version one. I needed something clear enough to show and fast enough that the momentum didn't disappear halfway through.\\n\\nHere's what came out of it: {projectsharelink}\\n\\nWant to try it yourself? My invite gets you a free trial: {referrallink}\\n#ProductDevelopment #AIProducts #StartupBuilding","template3":"I've had the concept for {projectname} in my head for a while, but it only started to feel real once I could share it.\\n\\nReaddy helped me get there faster. I used it to turn an early idea into a live project that I can show to people, collect feedback on, and improve from there.\\n\\nWhat I appreciate most is that it helped me get out of private planning mode. It's easy to keep refining in isolation. It's much harder, and usually more valuable, to put something in front of other people.\\n\\n{projectname} is still early, but I'd rather iterate on something real: {projectsharelink}\\n\\nCurious about Readdy? You can try it free through my link: {referrallink}\\n\\n#ProductBuilding #CustomerFeedback #AIProducts","template4":"Shipping early is still one of the best habits in product work, even when it's uncomfortable.\\n\\nI used Readdy to build {projectname} and get a first version out without getting trapped in endless setup and second-guessing. The real benefit was not just speed - it was maintaining clarity around the original idea while getting to something tangible.\\n\\nToo often, early-stage work gets delayed by friction before the real learning even begins. This felt like a better balance.\\n\\nSee what I shipped: {projectsharelink}\\n\\nIf you want to try the same workflow, here's my invite for a free trial: {referrallink}\\n#StartupBuilding #ProductStrategy #AIProducts","template5":"Good reminder that momentum matters more than perfection.\\n\\nI used Readdy to create {projectname} and move from a rough idea to a live page quickly enough that I could start learning from it. That felt more valuable than waiting until every detail was \\"ready.\\"\\n\\nThere's a big difference between thinking a project makes sense and seeing how it lands when people can actually explore it. Getting to that stage sooner changes the quality of every decision that follows.\\n\\nStill version one, but that's the point: {projectsharelink}\\n\\nMy invite if you want to try Readdy free: {referrallink}\\n\\n#ProductDevelopment #BuildInPublic #AIProducts","template6":"I wanted a faster way to test an idea without turning it into a full production cycle on day one.\\n\\nReaddy helped me build {projectname} and get it into a shape that feels real enough to share and iterate on. For early validation work, that speed makes a big difference.\\n\\nWhat made this useful was the ability to keep moving while the idea was still fresh. Less time stuck at the starting line, more time learning from something that already exists.\\n\\nHere it is: {projectsharelink}\\n\\nIf you want to give Readdy a try, here's my link: {referrallink}\\n\\n#EarlyStageStartups #ProductValidation #AIProducts","template7":"There's a big difference between having an idea and having something people can open in a browser.\\nI used Readdy to build {projectname} and close that gap much faster than I normally would. Once the project became something concrete, the next steps became clearer too - positioning, messaging, usefulness all become easier to evaluate when you're reacting to something real.\\n\\nGlad this moved from \\"idea I should work on someday\\" to something I can actually show: {projectsharelink}\\n\\nWant to try Readdy? Free to start through my invite: {referrallink}\\n\\n#ProductStrategy #StartupBuilding #AIProducts","template8":"I've been trying to get better at sharing work earlier instead of waiting until it feels \\"finished.\\"\\n\\nThis time I used Readdy to build {projectname} and publish a version I can put in front of other people. It's still early, but it's real, and that already makes the next step easier.\\n\\nA lot of good ideas stall because we wait for them to become complete before we let anyone see them. Getting something visible earlier often creates much better momentum.\\nHere's where it's at: {projectsharelink}\\n\\nIf you want to try building something yourself, my invite gets you in free: {referrallink}\\n\\n#BuildInPublic #ProductDevelopment #AIProducts","template9":"What I needed for this project was not more planning. I needed a faster path to something tangible.\\n\\nI used Readdy to create {projectname} and get to a live result quickly enough that the project could move from idea mode into feedback mode. Once there was a real link to share, conversations became more specific and decisions became easier.\\n\\nThat's probably the main takeaway: getting to something tangible earlier creates better next steps than waiting for a polished first impression.\\n\\nCheck it out: {projectsharelink}\\nMy invite if you're interested - free to try: {referrallink}\\n\\n#ProductValidation #StartupBuilding #AIProducts","template10":"Small win from this week: I took an idea from my backlog and finally shipped a first version.\\n\\nI used Readdy to build {projectname}, and it helped me get from rough thinking to a live page without the usual drag of starting from scratch. What I liked most was how quickly it turned a backlog item into something visible and discussable.\\n\\nThere's still more to do, but getting a first version out changes the nature of the project. It's no longer just an idea - it's something I can share and build on.\\n\\nHere's the live version: {projectsharelink}\\n\\nIf you want to try Readdy too, here's my invite: {referrallink}\\n#FounderJourney #ProductBuilding #AIProducts"},"reddit":{"title":{"template1":"Found an AI site builder that doesn't make everything look the same","template2":"Genuinely impressed by this AI website builder, had to share","template3":"Gave myself 4 hours to go from zero to live site. Here's what I got.","template4":"If you need a website fast and don't code, I found something that actually works","template5":"Sharing a tool that saved me a ton of time this week","template6":"Made {projectname} this week, turned out better than I expected","template7":"Just shipped [project description]. First time using an AI builder and wow","template8":"{projectname}. Went from idea to live in a day","template9":"I don't code. Never have. But I just made a whole website by myself","template10":"Built {projectname} because nothing else out there did what I wanted"},"body":{"template1":"I've tried a few AI builders before and they all gave me that same generic template look. Tried Readdy recently and was surprised. [say what felt different or useful]\\n\\nTook me [time] from start to finish. No code. If you've been looking for something like this, worth checking out.\\n\\nAnyone else tried it? Curious how others are using it.","template2":"I needed to make [say what you wanted to build] and didn't want to spend weeks on it. A friend mentioned Readdy so I gave it a shot.\\n\\nWhat surprised me was [say what specifically felt good]. Ended up with something I'm actually happy to show people.\\n\\nNot affiliated or anything, just thought people here might find it useful if you need to get a site up fast.","template3":"I've been procrastinating on {projectname} for weeks so I set a timer and committed to shipping whatever I had when it hit zero.\\n\\nUsed Readdy because I knew I couldn't afford to waste time on setup. Four hours later it was live.\\n\\nIs it perfect? No. Is it done? Also no. But it exists and that's more than I had yesterday.\\n\\nWhat would you prioritize fixing first?","template4":"I'm not a developer. Every time I needed a site I'd either pay someone or use a clunky drag-and-drop builder and hate the result.\\n\\nTried Readdy this week for {projectname} and honestly it was way smoother than I expected. [say what the experience was like]\\n\\nJust sharing in case anyone's in the same boat.","template5":"Made {projectname} with Readdy and it took me [time] instead of the [much longer amount of time] I was expecting.\\n\\n[say how long this kind of thing used to take or how annoying it usually was compared to this time]\\n\\nNot saying it's perfect for everything but for [your use case] it worked really well. Thought this sub might appreciate it.","template6":"[one sentence on what the project does]\\n\\nI used Readdy and the whole process was weirdly smooth. Went from idea to live site in [time]. [say what the experience was like]\\n\\nFeedback welcome. What would you improve?","template7":"I finally made {projectname}.\\n\\n[say what the project does]\\n\\nUsed Readdy to build it. I've tried other tools before and always ended up redoing everything manually. This time I barely had to touch anything. [add more about the experience]\\n\\nThoughts? Be honest.","template8":"[say what it is or why you made it]\\n\\nI used Readdy and it was genuinely the fastest I've ever gone from \\"I want to make this\\" to \\"ok it's live.\\" [say what specifically felt fast]\\n\\nAnyone have suggestions? What would you do differently?","template9":"I always assumed making a website meant either paying someone or learning to code. Neither happened so my ideas just sat there.\\n\\nLast week I tried Readdy and somehow ended up with {projectname}.\\n\\n[say what you built or what the site is for]\\n\\nThe whole thing took me [time]. No code, no templates, I just described what I wanted and tweaked from there. Still can't believe it actually worked.\\n\\nIs it obvious I have no technical background? What should I fix?","template10":"Every tool I found for [your use case] was either too complicated, too expensive, or just ugly. So I made my own with Readdy.\\n\\n[say how your project solves that problem]\\n\\nTook me [time] to get it live. Curious if other people have the same frustration or if it's just me."}}}`),Jie={$comment:Bie,tabs:Uie,campaign:$ie,guidelines:Vie,composer:Gie,submit:Hie,submitList:Wie,status:Qie,statusInfo:qie,error:zie,submissionRules:Kie,templates:Yie},Zie="All keys in this file are prefixed with: activity.terms",Xie="Terms and Conditions",eae={title:"Eligibility",point1:"You can invite new friends or existing Free users who have never successfully paid on {brandName}.",billingCheck:"You can visit the {subscriptionPage} to review billing and invoices and confirm whether the account qualifies as a Free user who has never successfully paid.",subscriptionPage:"Subscription page"},tae={title:"Reward Mechanism",point1:"Eligible invitees receive a one-time 2,500 credit bonus after their first successful paid subscription through an invite link.",point2:"Inviters receive 2,500 credits for each eligible friend who completes their first successful paid subscription.",point3:"Any paid plan qualifies, and there is no limit to the number of successful referrals."},nae={title:"Important Notes:",point1:"If an invited friend cancels their subscription or downgrades to the Free plan during their billing cycle, rewards for both parties will expire at the end of the subscription period. Only unused credits will be forfeited.",point2:"Before the first successful paid subscription, referral attribution can be updated by the invited user's latest successful sign-in or sign-up through an invite link.",point3:"After the invited user completes their first successful paid subscription, the inviter is locked. If a refund is issued, any unused reward credits from this referral will be automatically reversed for both parties.",point4:"Credit consumption priority: Normal credits > Free credits > Expiring reward credits (soonest expiration first) > Reward credits"},sae={$comment:Zie,title:Xie,eligibility:eae,rewards:tae,notes:nae},oae="No Sites Available",iae="You don't have access to any sites yet. Please contact your agency for assistance.",aae={title:oae,desc:iae},rae="All keys in this file are prefixed with: agentEntry",lae="Creating your website...",cae="This may take a few seconds",dae="Go to Home",uae={invalidParams:"Invalid Parameters",invalidParamsDetail:"Required parameters are missing. Please check the URL and try again.",createFailed:"Failed to Create Project",unknown:"Something went wrong"},pae={$comment:rae,loading:lae,loadingSubtext:cae,goHome:dae,error:uae},hae="When editing the page, break down complex requests into smaller ones",fae="Click any button or link on the generated page, to generate connected pages with same style",mae="Select to directly edit any text or image",gae="Use our selector [{shortcut}] to select and modify specific elements on the page",yae="Add reference images for better results, especially when starting your designs",vae="Select any previous version to continue from there",bae="Need more or fewer design options each time? Change it in your Account settings",wae='Need a new page? Click "+ New Page" button on the top left corner',Sae="When editing the page, break down complex requests into smaller ones",_ae="Click any button or link on the generated page, to generate connected pages with same style",Cae="Select to directly edit any text or image",Iae="Use our selector [{shortcut}] to select and modify specific elements on the page",Eae="Add reference images for better results, especially when starting your designs",Tae="Select any previous version to continue from there",Pae="Need more or fewer design options each time? Change it in your Account settings",kae='Need a new page? Click "+ New Page" button on the top left corner',Aae="Got multiple requests? Try sending them one at a time",Rae='Need a new page? Click "+ New Page" button on the top left corner',Dae={preview1:hae,preview2:fae,preview3:mae,preview4:gae,preview5:yae,preview6:vae,preview7:bae,preview8:wae,edit1:Sae,edit2:_ae,edit3:Cae,edit4:Iae,edit5:Eae,edit6:Tae,edit7:Pae,edit8:kae,failed1:Aae,failed2:Rae},xae="Crawler access unknown",Lae="Some AI crawlers are blocked",Oae="AI crawlers can reach your content",Nae="AI crawlers are allowed",Mae="Checking crawler access…",Fae="robots: allowed",jae="robots: blocked",Bae="robots: unknown",Uae="blocked by robots.txt",$ae="accessible",Vae="allowed by robots; live fetch not confirmed",Gae="just now",Hae="{n}m ago",Wae="{n}h ago",Qae="{n}d ago",qae="{reached} of {total} reached",zae="checked {ago}",Kae="Re-check",Yae="Re-check AI crawler access",Jae={overallUnknown:xae,overallBlocked:Lae,overallReachable:Oae,overallAllowed:Nae,checking:Mae,robotsAllowed:Fae,robotsBlocked:jae,robotsUnknown:Bae,srBlocked:Uae,srAccessible:$ae,srAllowedUnconfirmed:Vae,justNow:Gae,minutesAgo:Hae,hoursAgo:Wae,daysAgo:Qae,reachedCount:qae,checkedAgo:zae,recheck:Kae,recheckAria:Yae},Zae="AI-Readable Sites",Xae="Enter www.yoursite.com",ere="Add site",tre="Invalid domain format. Please check and try again.",nre="Loading AI-Readable Sites",sre="Domain",ore="Status",ire="Updated",are="Previous page",rre="Next page",lre="Unable to load sites",cre="Unable to load AI-Readable Sites",dre="Retry",ure="Just now",pre="{n} min ago",hre="{n} hr ago",fre="Get your website into AI answers",mre="This domain is hosted on {brandName} — use ",gre=" for a {brandName} site.",yre="AEO/GEO Optimization",vre="Built and hosted on {brandName}? Use ",bre=" instead.",wre="🔎 What does this do?",Sre="Already have an external website? Just enter your domain. We add AI-readable assets without migrating or changing your existing site, helping your business appear in AI answers.",_re="✅ Before you start",Cre="We currently only support domains with the www prefix, such as www.yoursite.com.",Ire="We currently only support domains with the www prefix, such as ",Ere=".",Tre="www.yoursite.com",Pre="Platform default addresses aren't supported. Use your own domain (DNS you can edit), like ",kre="blog.yoursite.com",Are=".",Rre="We couldn't find any DNS records for this domain. Please double-check the domain you entered.",Dre="We couldn't reach this website. Make sure it's publicly accessible, then try again.",xre={activationWaitingUser:{label:"Connect domain",description:"Add the CNAME record at your DNS provider to finish connecting.",action:"Continue setup"},readyToConnect:{label:"Ready to connect",description:"Your website analysis is ready. Continue to connect your domain.",action:"Continue setup"},analyzing:{label:"Analyzing",description:"Reviewing your website and identifying AI visibility opportunities.",action:"View progress"},checking:{label:"Verifying",description:"{brandName} is checking DNS, SSL, and AI-readable outputs.",action:"View status"},live:{label:"AI Readable",description:"AI-readable outputs are live and verified.",action:"View result"}},Lre="This domain's DNS is managed by WordPress.com (nameserver connection), which isn't supported yet. Reconnect it in WordPress using the DNS-records option, then try again.",Ore={title:Zae,addPlaceholder:Xae,addAriaLabel:ere,invalidDomain:tre,loadingAriaLabel:nre,colDomain:sre,colStatus:ore,colUpdated:ire,prevPage:are,nextPage:rre,errorTitle:lre,errorFallback:cre,retry:dre,updatedJustNow:ure,updatedMinAgo:pre,updatedHrAgo:hre,emptyTitle:fre,readdyHostedNotePrefix:mre,readdyHostedNoteSuffix:gre,geoOptimization:yre,emptyGeoNotePrefix:vre,emptyGeoNoteSuffix:bre,emptyGuideAboutTitle:wre,emptyGuideAboutDesc:Sre,emptyGuideWhoTitle:_re,emptyGuideWhoPoint1:Cre,rootUnsupportedPrefix:Ire,rootUnsupportedSuffix:Ere,rootExample:Tre,platformDefaultNotePrefix:Pre,platformDefaultExample:kre,platformDefaultNoteSuffix:Are,notResolvableNote:Rre,originUnreachableNote:Dre,status:xre,wordpressNsNote:Lre},Nre={retry:"Retry",loadingWorkspace:"Loading your workspace…",home:"Home",page:"Page",errors:{loadSetup:"Unable to load AI Ready setup",refreshSetup:"Unable to refresh AI Ready setup",loadActivationGuide:"Unable to load activation guide",loadReadability:"Unable to load readability result",createSite:"Unable to create AI Ready Site",startGeneration:"Unable to start AI Ready generation",loadAsset:"Unable to load AI Ready asset",prepareActivation:"Unable to prepare activation",verifyActivation:"Unable to verify ac