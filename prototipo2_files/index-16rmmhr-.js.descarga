bill.",pfe="Once payment is complete, you can publish new websites. For more details, see ",hfe="Extra Sites: Pricing and Publishing Rules",ffe=".",mfe="Pay Now",gfe="This project cannot be published at this time. Please contact your administrator to publish the project.",yfe={$comment:cfe,title:dfe,subtitle:ufe,bodyPrefix:pfe,article:hfe,bodySuffix:ffe,payButton:mfe,agencyCannotPublish:gfe},vfe="All keys in this file are prefixed with: components.verifyEmail",bfe="Purchase Successful",wfe="Verify Email",Sfe="Skip",_fe="Go to your email:",Cfe="You will receive an email from {email}. Please click the link to verify your email.",Ife="💡 Didn't receive the verification email?",Efe=`Search for the keyword "Verify email". If you don't find it, please check your spam/junk folder.`,Tfe={checking:"Checking",verified:"I've Verified My Email",resend:"Resend Verification Email",resendCountdown:"Resend Verification Email ({countdown}s)"},Pfe={resendSuccess:"Resend Successful",verifyFailed:"Verify failed. Please wait a few minutes and try again",verifySuccess:"Your email verify successful"},kfe={$comment:vfe,purchaseSuccessful:bfe,title:wfe,skip:Sfe,goToEmail:_fe,emailVerificationText:Cfe,didntReceive:Ife,checkSpam:Efe,buttons:Tfe,toast:Pfe},Afe="All keys in this file are prefixed with: components.whatsNewModal",Rfe="More Release Notes",Dfe="Got it",xfe="Learn More",Lfe="Discover What's New",Ofe={title:'Unlock Superior Generation with <span style="color: #5A30F7;">React</span> Project',description:'Upgrade to <span style="font-weight: 700;">React</span> for significantly better website generation. Experience superior results with easy integration of powerful tools like <span style="font-weight: 700;">Supabase, Google Analytics, Stripe, Shopify</span>, and much more.',"readdy-agent":{title:"AI Receptionist",description:"Your AI-powered chat and voice assistant that provides 24/7 customer support, answers questions, engages website visitors, and schedules appointments automatically, so you can focus on your business."}},Nfe={title:'<span style="color: #5A30F7;">Quick Edit</span>',description:'Update what you see, where you see it. <span style="font-weight: 700;">Quick Edit</span> lets you make inline changes to text, links, and images in Preview. Review and send all changes at once to stay in control.'},Mfe={"readdy-booking":{title:'<span style="color: #5A30F7;">{brandName} Booking</span>',description:"Set up booking calendars, manage availability, and handle appointments in {brandName}. Let your visitors book services directly on your website, all in one seamless experience."},"credit-guard":{title:'<span style="color: #5A30F7;">Credit Care</span>',description:"Protect your credits when exploring AI generations. Discard unsatisfactory results, restore previous versions, and get your credits back. Credit Care usage resets monthly."},community:{title:'<span style="color: #5A30F7;">Community</span>',description:'Join the new <span style="font-weight: 700;">{brandName} Community</span> to connect with fellow {brandName}-ers! Share your work and experiences, ask questions, offer feedback. Be part of the conversation, learn from each other, and grow together — all within the {brandName} community.'},"quick-edit":{title:'<span style="color: #5A30F7;">Quick Edit</span>',description:'Update what you see, where you see it. <span style="font-weight: 700;">Quick Edit</span> lets you make inline changes to text, links, and images in Preview. Review and send all changes at once to stay in control.'}},Ffe={"team-collaboration":{title:'<span style="color: #5A30F7;">Collaboration</span>',description:"Team Collaboration is now available! You can invite members to join your project via email or invitation link. Team members can view and edit within the same project, and project owners can manage editing permissions for each member."},"project-notification-email":{title:'<span style="color: #5A30F7;">Project Email</span>',description:'Configure <span style="font-weight: 700;">notification emails for each project independently</span>. Receive form submissions to different email addresses for different projects, making it easier to manage multiple projects and collaborate with teams.'}},jfe={resend:{title:'<span style="color: #5A30F7;">Resend</span>',description:'Send form notification emails from <span style="font-weight: 700;">your own custom domain</span> with Resend integration. Customize sender name, email address, and subject line to match your brand identity and improve email deliverability.'}},Bfe={"social-media":{title:'<span style="color: #5A30F7;">AI Social Posts</span>',description:'Generate a full week of social posts for <span style="font-weight: 700;">Facebook, Instagram, X, and LinkedIn</span> in one click. AI recommends the best publish times, can auto-publish each post, and tracks performance plus site visitors from social traffic.'}},Ufe={"outreach-campaign":{title:'<span style="color: #5A30F7;">Email Marketing</span>',description:'Upload prospects, personalize emails with <span style="font-weight: 700;">dynamic variables</span>, and launch campaigns in one flow. Generate tailored websites for each lead and move from setup to send without leaving Readdy.'}},$fe={"file-upload-parsing":{title:'<span style="color: #5A30F7;">File Upload</span>',description:'Upload PDFs, spreadsheets, text/code files, and images directly in project creation or chat. AI can read <span style="font-weight: 700;">PDFs, spreadsheets, text/code files, and common images</span> to turn requirements and data into pages, while other files stay available as project assets.'}},Vfe={"referral-rewards":{title:'<span style="color: #5A30F7;">Get Free Credits</span>',description:'Invite an eligible friend to Readdy and once they complete their first paid subscription, <span style="font-weight: 700;">both of you get 2,500 credits</span>.',action:"Invite now"}},Gfe={"project-transfer":{title:'<span style="color: #5A30F7;">Project Transfer</span>',description:'Project Transfer lets you move a project from one Readdy account to another. This is useful when you need to <span style="font-weight: 700;">hand a project over to a client</span>, a teammate, or another account you own.'}},Hfe={shop:{title:'<span style="color: #5A30F7;">Shop</span>',description:'Turn your website into a ready-to-sell online store with <span style="font-weight: 700;">Import Products</span>, <span style="font-weight: 700;">Manage Inventory</span>, and <span style="font-weight: 700;">Receive Orders</span> all in one place.'}},Wfe={"white-label":{title:'<span style="color: #5A30F7;">White Label</span>',description:"White Label helps agencies turn Readdy into an AI-powered growth engine for their own brand. It lets you deliver the full client-facing experience under your own identity, with branded login, dashboard URLs, published site domains, and outgoing white-label emails."}},Qfe={"agency-unlimited-credits":{title:'<span style="color: #5A30F7;">Unlimited Credits</span>',description:'Agency-exclusive AI credits with <span style="font-weight: 700;">no usage caps</span>. Stop tracking consumption—just focus on delivering exceptional websites.'},"email-language":{title:'<span style="color: #5A30F7;">Email Language</span>',description:'Set the language used in <span style="font-weight: 700;">Send Notifications</span> emails for each project. Support for <span style="font-weight: 700;">English, 简体中文, 日本語, 한국어, Español, Português, Deutsch, Français, and Italiano</span> helps every auto-sent customer email match your audience from the first reply.'}},qfe={"prompt-in-place":{title:'<span style="color: #5A30F7;">Prompt in Place</span>',description:'<span style="font-weight: 700;">Select, Type, Send.</span> Drop a prompt straight into the selector toolbar for the exact element you picked, and your message is automatically queued so you can keep editing without breaking flow.'}},zfe={"special-effects":{title:'<span style="color: #5A30F7;">Special Effects</span>',description:'Use AI-generated <span style="font-weight: 700;">Special Effects</span> that deliver standout visual. Preview them instantly, remix what you love, and bring those polished moments into your own website to make it feel more striking, memorable, and premium.',action:"Explore"}},Kfe={animation:{title:'<span style="color: #5A30F7;">Animation</span>',description:'Select any element and add polished motion in seconds. <span style="font-weight: 700;">Animate</span> recommends compatible effects, lets you preview them instantly, and applies your choice so buttons, sections, and visuals feel more alive without hand-coding animations.'}},Yfe={paypal:{title:'<span style="color: #5A30F7;">PayPal</span>',description:'Connect <span style="font-weight: 700;">PayPal</span> to accept secure payments from customers worldwide and manage payment orders directly in {brandName}.'}},Jfe={"toss-payments":{title:'<span style="color: #5A30F7;">Toss Payments</span>',description:'Connect <span style="font-weight: 700;">Toss Payments</span> to accept secure payments from Korean customers using cards and popular local payment methods, while managing payment orders directly in {brandName}.'}},Zfe={"ai-readable-sites":{title:'<span style="color: #5A30F7;">AI Readable Sites</span>',description:"Make your website easier for AI to understand, discover, and cite."}},Xfe={$comment:Afe,moreReleaseNotes:Rfe,buttonGotIt:Dfe,buttonLearnMore:xfe,newFeatures:Lfe,v1:Ofe,v3:Nfe,v4:Mfe,v5:Ffe,v6:jfe,v7:Bfe,v8:Ufe,v9:$fe,v10:Vfe,v11:Gfe,v12:Hfe,v13:Wfe,v14:Qfe,v15:qfe,v16:zfe,v17:Kfe,v19:Yfe,v20:Jfe,v21:Zfe},eme="All keys in this file are prefixed with: dashboard",tme={title:"My Projects",empty:"No projects yet. Create your first project above!",loading:"Loading projects..."},nme={pages:"pages",published:"Published"},sme={title:"Templates"},ome={$comment:eme,myProjects:tme,projectCard:nme,templates:sme},ime={eyebrow:"{brandName} Domains",title:"Start building your online presence tod