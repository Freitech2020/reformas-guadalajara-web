{chatText}`},leadsCollection:{label:"Leads Collection"},resend:{label:"Resend"},mailchimp:{label:"Mailchimp"},shopify:{label:"Shopify"},stripe:{label:"Stripe"},fullyWhiteLabeledPlatform:{label:"Fully White Labeled Platform"},clientBilling:{label:"Client Billing"},customBrandingUi:{label:"Custom Branding UI"},brandedClientLoginScreen:{label:"Branded Client Login Screen"},customPlatformAndSiteDomain:{label:"Custom Platform & Site Domain"},customEmailTemplates:{label:"Custom Email Templates"},clientPermissionSettings:{label:"Client Permission Settings"}},tooltips:{creditCare:"Discard an unsatisfactory AI generation, restore the previous version, and refund the credits used. Usage resets each month.",readdyBackend:"Readdy's built-in backend stack for databases, functions, and secrets. No external setup required.",extraSiteHosting:"Shown at the original monthly price. Extra site hosting still receives period-based discounts during checkout.",aiSeoAnalysis:"AI website health checker that analyzes SEO, performance, security, accessibility, and user experience issues.",aiReadable:"For sites published outside Readdy. Makes them discoverable by AI search and answer engines.",aiVisibility:"For sites published with Readdy. Makes them discoverable by AI search and answer engines.",requiresPublish:"Available after your site is published.",aiReceptionist:"Helps answer visitor questions and capture contact details.",leadsCollection:"Limits how many leads you can collect from forms each month.",clientPermissionSettings:"Manage what actions clients can take within a project."}},table:{monthlyCredit:"Monthly Credit Quota",yearlyCredit:"Yearly Credit Quota",yearlyCreditsUpfront:"Yearly Credits Upfront",creditGuard:"Credit Guard",projectLimit:"Project Limit",projectCollaboration:"Project Collaboration",projectEditors:"Project Editors",exportToFigma:"Export to Figma",editExportCode:"Edit & Download Code",resendIntegration:"Resend Integration",websiteDeployment:"Website Deployment",freeCu